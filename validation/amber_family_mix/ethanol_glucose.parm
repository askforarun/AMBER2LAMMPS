# Force field parameters generated from AMBER topologies

# Mixed AMBER-family 1-4 scaling: one hybrid instance per active profile.
# All I-J coefficients are explicit; cross-profile pairs use Lorentz-Berthelot mixing.
# LAMMPS requires fractional global 1-4 weights before hybrid instances may override them.
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333
pair_style hybrid lj/cut/coul/long 9 9 lj/cut/coul/long 9 9
pair_modify tail yes
pair_modify pair lj/cut/coul/long 1 special lj 0.0 0.0 0.5 special coul 0.0 0.0 0.8333333333
pair_modify pair lj/cut/coul/long 2 special lj 0.0 0.0 1 special coul 0.0 0.0 1
