units real
atom_style full
boundary p p p
# Match AMBER's electrostatic conversion factor (332.0522173) to the
# LAMMPS real-units factor (332.06371).
dielectric 1.0000346111225924

bond_style harmonic
angle_style harmonic
dihedral_style fourier
pair_style lj/cut/coul/long 9.0 9.0

read_data work/glucose.data
include work/glucose.parm
pair_modify mix arithmetic tail yes table 0
kspace_style ewald 1.0e-8
kspace_modify gewald 0.42001

thermo_style custom ebond eangle edihed eimp evdwl ecoul elong etail pe
dump validation_forces all custom 1 work/lammps_forces.dump id fx fy fz
dump_modify validation_forces sort id
run 0
