units real
atom_style full
boundary p p p

bond_style harmonic
angle_style harmonic
dihedral_style fourier

read_data ethanol_glucose.data

# The generated include configures pair_style hybrid, profile-specific 1-4
# scaling, the complete I-J matrix, and all bonded coefficients.
include ethanol_glucose.parm
kspace_style pppm 1.0e-8

thermo_style custom ebond eangle edihed eimp evdwl ecoul elong etail pe
run 0
